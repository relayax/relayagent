{
  "name": "@relay/relayjs",
  "version": "0.1.0",
  "type": "module",
  "description": "Relay FE SDK. 클라이언트 전송 계약 v1 의 SDK(client)와 채팅 위젯 번들. npm 임포트, file: 의존성, 기판 /assets 번들 서빙 세 경로로 소비한다.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/index.d.ts",
      "default": "./src/client.ts"
    },
    "./transport": "./src/chat/transport.ts",
    "./envelope-reducer": "./src/chat/envelope-reducer.ts",
    "./sse": "./src/sse.ts",
    "./next-preset.mjs": "./next-preset.mjs"
  },
  "files": [
    "src",
    "next-preset.mjs"
  ],
  "scripts": {
    "build:chat": "node chat-build.mjs",
    "build:chat:dev": "node chat-build.mjs --dev"
  },
  "dependencies": {
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.11.0",
    "@assistant-ui/react-markdown": "^0.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.24.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0"
  },
  "sideEffects": [
    "./src/chat/main.tsx"
  ],
  "keywords": [
    "relay",
    "agent",
    "chat",
    "harness"
  ],
  "license": "MIT"
}
