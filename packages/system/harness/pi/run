#!/bin/bash
set -eo pipefail
VERB="${1:-session}"

# 실행 파일 해소 - 같은 CLI 가 버전에 따라 다른 이름으로 깔린다.
# @mariozechner/pi 는 0.7 이하에서 bin=pi, 0.30 이후로 bin=pi-pods 다.
# 게다가 pi 라는 이름은 별개 패키지(@mariozechner/pi-coding-agent)도 쓰므로
# 이름만 믿지 않고 --help 에 pods 표면이 있는지로 판별한다.
# 파이프 대신 변수에 받는다: grep -q 가 먼저 끊으면 pipefail 이 SIGPIPE(141)를 성공 위에 덮어쓴다
PI=""
pi_bin() {
  local c h
  for c in pi pi-pods; do
    command -v "$c" >/dev/null 2>&1 || continue
    h="$("$c" --help </dev/null 2>/dev/null || true)"
    case "$h" in *pods*) PI="$c"; return 0 ;; esac
  done
  return 1
}
NEED_PI="pi CLI 없음: npm install -g @mariozechner/pi (최근 버전은 실행 파일이 pi-pods 로 깔립니다)"

case "$VERB" in
  info)
    # 자격이 기판 소유(PI_API_KEY)라 login 동사가 없다 - 화면은 토큰 붙여넣기로 처방한다.
    # capabilities 는 실제 구현한 물리 능력만: cancel(stdin 제어 수신 후 자식 종료),
    # resume(pi 의 --continue). vision·effort 는 pi agent 표면에 대응 플래그가 없어 선언하지 않는다
    ACC=null
    if [ -n "${PI_API_KEY:-}" ]; then ACC='{"method":"token","env":"PI_API_KEY"}'; fi
    printf '{"name":"pi","provider":"vllm","protocol":2,"verbs":["session","setup","models","commands","info"],"capabilities":["cancel","resume"],"account":%s,"mcp":false,"subagents":false,"note":"MCP 도 서브에이전트 실행 경로도 없어 relay 도구는 이 하네스에서 비활성이다. 페르소나·담장·스킬은 첫 메시지 지침으로 강등된다. 대화 이어가기는 pi 의 --continue 라 슬롯이 아니라 cwd 단위로 묶이고, 네이티브 세션 id 는 구버전 JSONL 에서만 드러난다."}\n' "$ACC"
    exit 0
    ;;
  setup)
    # 종료코드가 미준비의 축을 가른다: 3 = 도구 없음(설치), 그 외 비0 = 자격 없음(토큰 입력)
    if ! pi_bin; then
      echo "$NEED_PI"
      exit 3
    fi
    if [ -z "${PI_API_KEY:-}" ]; then
      echo "PI_API_KEY 미설정: relay connect llm vllm 으로 API 키를 넣으세요"
      exit 1
    fi
    # pi list 는 pod 에 SSH 를 태워 느리고 멈출 수 있다. setup 은 설치 스윕에서 후보마다
    # 연달아 불리는 자리이므로, 로컬 설정만 읽는 pi pods 로 pod 등록 여부까지만 본다.
    # 예전 구현은 여기서 pi list | head -3 을 돌렸는데 head 가 먼저 끊으면 pipefail 이
    # 준비된 상태를 141 로 만들어 "자격 없음" 으로 오진했다
    PODS="$("$PI" pods </dev/null 2>&1 || true)"
    case "$PODS" in
      *"No pods configured"*)
        echo "등록된 pod 없음: pi pods setup <이름> \"ssh root@<호스트>\" --mount <마운트> 로 pod 을 먼저 붙이세요"
        exit 1
        ;;
    esac
    VER="$("$PI" --version </dev/null 2>/dev/null || true)"
    printf '%s %s 준비됨\n%s\n' "$PI" "$VER" "$PODS"
    exit 0
    ;;
  models)
    # 정본 = pi list (활성 pod 에서 도는 모델). 이름은 pi start --name 으로 사용자가 정한 값이고
    # pi agent 의 첫 인자가 바로 그 이름이라 이 목록이 그대로 계약이다.
    # pi 에는 문서화된 별칭이 없다 - 강등은 다음 한 걸음을 적은 안내 항목까지이고,
    # 하드코딩한 모델 id 는 내지 않는다(낡은 목록이 정본 행세를 한다)
    if ! pi_bin; then
      echo "models 강등 - $NEED_PI" >&2
      echo '["(pi CLI 설치 후 pi list 의 이름이 여기 나옵니다)"]'
      exit 0
    fi
    PI="$PI" node --input-type=module -e '
import { spawnSync } from "node:child_process";
const out = (xs) => process.stdout.write(JSON.stringify(xs) + "\n");
const degrade = (why, hint) => { process.stderr.write("models 강등 - " + why + "\n"); out([hint]); };

// pod 이 안 붙으면 SSH 가 매달린다 - 화면을 세우지 않도록 시간을 건다
const r = spawnSync(process.env.PI, ["list"], { encoding: "utf8", timeout: 15000, stdio: ["ignore", "pipe", "pipe"] });
const text = ((r.stdout ?? "") + "\n" + (r.stderr ?? "")).replace(/\u001b\[[0-9;]*m/g, "");
// pi list 한 줄 형식: "  <이름> - Port 8001 - GPU 0 - PID 1234"
const names = [...text.matchAll(/^\s+(\S+) - Port \d+ - /gm)].map((m) => m[1]);
if (names.length) out([...new Set(names)]);
else if (/No active pod/.test(text)) degrade("활성 pod 없음", "(pi pods active <이름> 으로 pod 을 고르세요)");
else if (/No models running/.test(text)) degrade("pod 에 도는 모델 없음", "(pi start <모델> --name <이름> 으로 모델을 띄우세요)");
else degrade("pi list 실패" + (r.error ? ": " + r.error.message : " (exit " + r.status + ")"), "(pi list 가 이름을 내면 여기 나옵니다)");
'
    exit 0
    ;;
  commands)
    # pi agent 에는 문서화된 슬래시 커맨드가 없다 - 없는 것을 지어내지 않는다
    echo '[]'
    exit 0
    ;;
  session)
    ;;
  *)
    echo "지원하지 않는 동사: $VERB (session|setup|models|commands|info)"
    exit 2
    ;;
esac

B="${RELAY_BUNDLE:-}"
HEADLESS=0
if [ $# -gt 1 ] && [ -n "${2:-}" ]; then HEADLESS=1; fi

# 실패는 종료코드로, 사유는 봉투(headless)나 stderr(TTY)로 - 텍스트로 위장하지 않는다
fail() {
  if [ "$HEADLESS" = 1 ]; then
    MSG="$1" node --input-type=module -e 'process.stdout.write(JSON.stringify({ event: "error", message: process.env.MSG }) + "\n");'
  else
    echo "$1" >&2
  fi
  exit 1
}

if [ -z "$B" ] || [ ! -f "$B/meta.json" ] || [ ! -f "$B/persona.md" ]; then
  fail "번들이 없습니다(RELAY_BUNDLE) - 기판이 스폰한 세션이 아닙니다"
fi
pi_bin || fail "$NEED_PI"
if [ -z "${RELAY_MODEL:-}" ]; then
  fail "pi 하네스는 모델 지정이 필요합니다: relay model <패키지> <이름> (pi list 의 이름)"
fi

# 조립 지점은 첫 메시지 본문 하나뿐이다. pi agent 는 --base-url·--model·--api-key·--system-prompt 를
# 자기가 채워 넣고 나머지 인자만 에이전트로 통과시키므로, 시스템 프롬프트 자리는 이미 도구 것이다.
# PI_CONFIG_DIR 격리는 쓰지 않는다: pod 좌표(pods.json)와 세션 기록이 그 안에 있어 옮기면
# pi 가 pod 을 잃는다. 사용자의 ~/.pi 에는 아무것도 쓰지 않고 산출물은 전부 번들 안에 둔다
B="$B" node --input-type=module -e '
import fs from "node:fs";
import path from "node:path";
const B = process.env.B;
const meta = JSON.parse(fs.readFileSync(B + "/meta.json", "utf8"));

let doc = fs.readFileSync(B + "/persona.md", "utf8");
doc += "\n\n# 기판 (Relay)\n"
  + "- 작업 무대(cwd): " + (meta.workspace ?? process.cwd()) + "\n"
  + "- 파일 교환 무대: " + meta.stage + " - 사용자에게 채팅으로 전달할 파일은 여기 놓는다. 첨부도 여기서 온다\n";

// 담장 번역: pi 에는 권한 규칙도 훅도 없어 이중 번역이 불가능하다. 지침 수준으로 강등하고
// 강등했다는 사실을 본문에 적는다 (조용히 버리면 막힌 줄 알고 쓰게 된다)
const deny = meta.hooks?.deny ?? [];
if (deny.length) {
  doc += "- 접근 금지: " + deny.join(", ") + "\n"
    + "  pi 에는 도구 호출을 막는 장치가 없다. 이 담장은 지침이니 스스로 지켜라\n";
}

// 스킬은 주입 경로가 없다 - 번들 경로만 알려주고 pi 의 파일 도구로 직접 읽게 한다
const sk = path.join(B, "skills");
const skills = fs.existsSync(sk) ? fs.readdirSync(sk).filter((n) => fs.existsSync(path.join(sk, n, "SKILL.md"))) : [];
if (skills.length) {
  doc += "\n# 스킬 (문서로 강등)\n필요하면 아래 파일을 직접 읽어라.\n"
    + skills.map((n) => "- " + n + ": " + path.join(sk, n, "SKILL.md")).join("\n") + "\n";
}
if ((meta.agents ?? []).length) {
  // 위임 문(agent_dispatch)은 relay MCP 도구인데 pi 에는 MCP 가 없다 — 위임 불가를 정직하게
  doc += "\n# 서브에이전트\n이 하네스에는 MCP 가 없어 위임 문(agent_dispatch)에 닿지 못한다. 위임하지 말고 직접 처리하라.\n";
}
fs.writeFileSync(B + "/system.md", doc);
'

# 대화형 = 메시지 없이 부르는 것이 pi 의 규약이다 (pi agent <이름> [options]).
# -i 플래그는 없다: 정의되지 않은 단문자 플래그를 인자 파서가 위치 인자로 흘려보내
# "-i" 자체가 첫 사용자 메시지가 된다. 이 경로에는 지침을 넣을 자리가 없어 안내만 남긴다
if [ "$HEADLESS" = 0 ]; then
  echo "[relay] 페르소나는 pi 대화형 모드에 주입되지 않습니다. 지침 본문: $B/system.md" >&2
  if [ -f "$B/pi-started" ]; then
    exec "$PI" agent "$RELAY_MODEL" -c
  fi
  exec "$PI" agent "$RELAY_MODEL"
fi

# Windows: node 의 spawn 은 PATH 의 확장자 없는 npm shim 이나 .cmd 를 실행하지 못하고 ENOENT 로
# 즉사한다(#4 실측 - claude-code 어댑터와 같은 처방). 실행 계획을 여기서 정한다:
# 오버라이드 env → 진짜 .exe 직접 → sh shim 은 bash 로 감쌈. 판정 불능은 조용히 넘기지 않는다
PI_BIN="${RELAY_PI_BIN:-$PI}"
PI_SHIM=""
if [ -z "${RELAY_PI_BIN:-}" ]; then
  case "$OSTYPE" in
    msys*|cygwin*)
      SHIM="$(command -v "$PI" || true)"
      case "$SHIM" in
        "") fail "$NEED_PI" ;;
        /*.exe) PI_BIN="$(cygpath -w "$SHIM")" ;;
        /*)
          PI_BIN="$(cygpath -w "$(command -v bash)")"
          PI_SHIM="$SHIM"
          ;;
        *) fail "pi 해석 불능 - command -v 가 절대경로가 아닌 값을 냈습니다: $SHIM" ;;
      esac
      ;;
  esac
fi

# 이어가기 마커가 있으면 지침을 다시 싣지 않는다 (pi 가 이전 대화를 이어붙인다)
CONT=""
if [ -f "$B/pi-started" ]; then CONT="1"; fi
if [ -n "$CONT" ]; then
  PROMPT="$2"
else
  PROMPT="$(printf '[지침]\n%s\n\n[사용자]\n%s' "$(cat "$B/system.md")" "$2")"
fi

# 세션 봉투(protocol 2): pi 의 JSONL(--json)을 relay 이벤트로 번역한다.
# 어휘가 버전마다 두 갈래라 둘 다 받고, 모르는 이벤트는 버린다 - 없는 이벤트는 지어내지 않는다.
#   구(pi-agent): session_start · assistant_message · tool_call/tool_result · token_usage · error · interrupted
#   신(pi-agent-core): message_update(text_delta) · message_end · tool_execution_start/end
# JSON 이 한 줄도 없으면(봉투를 모르는 구현) stdout 통짜를 종결 reply 한 줄로만 낸다.
# stdin 은 제어 채널 - {"type":"cancel"} 이면 자식을 끊고 실패로 종결한다
B="$B" PI_BIN="$PI_BIN" PI_SHIM="$PI_SHIM" CONT="$CONT" exec node --input-type=module -e '
import { spawn } from "node:child_process";
import fs from "node:fs";
import readline from "node:readline";
const B = process.env.B;
const emit = (o) => process.stdout.write(JSON.stringify(o) + "\n");
const errLog = fs.createWriteStream(B + "/stderr.log", { flags: "a" });

const args = ["agent", process.env.RELAY_MODEL, "--json"];
if (process.env.CONT) args.push("-c");
args.push(process.argv[1]);
// 실행 계획은 bash 가 정했다: PI_BIN(실행 파일) + 선택적 PI_SHIM(bash 로 읽는 npm shim)
const shim = process.env.PI_SHIM ? [process.env.PI_SHIM] : [];
const child = spawn(process.env.PI_BIN, [...shim, ...args], { stdio: ["ignore", "pipe", "pipe"] });
// spawn 실패(ENOENT 등)는 close 가 오지 않는다 - 방치하면 uncaught 로 죽어 계약이 깨진다
child.on("error", (e) => {
  emit({ event: "error", message: "pi 실행 실패: " + (e?.message ?? e) });
  process.exit(1);
});
child.stderr.pipe(errLog);
process.on("SIGTERM", () => child.kill("SIGTERM"));

let sawJson = false;
let raw = "";
let session = null;
let model = null;
let input = 0;
let output = 0;
let sawUsage = false;
let errMsg = null;
let cancelled = false;
const texts = [];
const tools = new Map(); // toolCallId -> 이름 (구 어휘의 tool_result 에는 이름이 없다)
const textOf = (m) => (Array.isArray(m?.content)
  ? m.content.filter((b) => b?.type === "text").map((b) => b.text ?? "").join("")
  : typeof m?.content === "string" ? m.content : "");

const rl = readline.createInterface({ input: child.stdout });
rl.on("line", (line) => {
  raw += line + "\n";
  let j;
  try { j = JSON.parse(line); } catch { return; }
  if (!j || typeof j.type !== "string") return;
  sawJson = true;
  if (j.type === "session_start") {
    session = j.sessionId ?? session;
    model = j.model ?? model;
  } else if (j.type === "assistant_message") {
    if (j.text) { emit({ event: "delta", text: j.text }); texts.push(j.text); }
  } else if (j.type === "tool_call") {
    tools.set(j.toolCallId, j.name);
    emit({ event: "tool", name: j.name, status: "start", ...(j.args ? { detail: String(j.args).slice(0, 200) } : {}) });
  } else if (j.type === "tool_result") {
    emit({ event: "tool", name: tools.get(j.toolCallId) ?? "tool", status: "end" });
    tools.delete(j.toolCallId);
  } else if (j.type === "token_usage") {
    input += j.inputTokens ?? 0; // inputTokens 는 prompt_tokens 라 캐시 토큰을 이미 품는다
    output += j.outputTokens ?? 0;
    sawUsage = true;
  } else if (j.type === "error") {
    errMsg = j.message ?? "pi 오류";
  } else if (j.type === "interrupted") {
    cancelled = true;
  } else if (j.type === "message_update") {
    const e = j.assistantMessageEvent;
    if (e?.type === "text_delta" && e.delta) emit({ event: "delta", text: e.delta });
  } else if (j.type === "message_end") {
    const m = j.message;
    if (m?.role === "assistant") {
      const t = textOf(m);
      if (t) texts.push(t);
      if (m.model) model = m.model;
      if (m.usage) { input += m.usage.input ?? 0; output += m.usage.output ?? 0; sawUsage = true; }
      if (m.stopReason === "error" && m.errorMessage) errMsg = m.errorMessage;
    }
  } else if (j.type === "tool_execution_start") {
    tools.set(j.toolCallId, j.toolName);
    emit({ event: "tool", name: j.toolName, status: "start", ...(j.args ? { detail: JSON.stringify(j.args).slice(0, 200) } : {}) });
  } else if (j.type === "tool_execution_end") {
    emit({ event: "tool", name: j.toolName ?? tools.get(j.toolCallId) ?? "tool", status: "end" });
    tools.delete(j.toolCallId);
  }
});

const ctl = readline.createInterface({ input: process.stdin });
ctl.on("line", (line) => {
  try {
    if (JSON.parse(line).type === "cancel") {
      cancelled = true;
      child.kill("SIGTERM");
    }
  } catch { /* 제어 아님 - 무시 */ }
});

child.on("close", (code) => {
  rl.close();
  ctl.close();
  process.stdin.destroy();
  if (cancelled) {
    emit({ event: "error", message: "취소됨" });
    process.exitCode = 130;
    return;
  }
  const text = (sawJson ? texts.join("\n\n") : raw).trim();
  if (code === 0 && text) {
    // 첫 호출이 성공한 뒤에만 이어가기 마커를 남긴다 - 실패한 턴에 마커가 생기면
    // 다음 턴이 지침 없이 이어붙는다
    if (!fs.existsSync(B + "/pi-started")) fs.writeFileSync(B + "/pi-started", "");
    emit({
      event: "reply",
      text,
      session,
      model: model ?? process.env.RELAY_MODEL ?? null,
      usage: sawUsage ? { input, output, context_window: null } : null,
    });
    return;
  }
  let tail = "";
  try { tail = fs.readFileSync(B + "/stderr.log", "utf8").trim().split("\n").slice(-3).join(" / "); } catch { /* 로그 없음 */ }
  emit({ event: "error", message: (errMsg ?? "pi 응답 없음 (exit " + code + ")") + (tail ? " - " + tail : "") });
  process.exitCode = 1;
});
' "$PROMPT"
