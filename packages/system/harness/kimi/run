#!/bin/bash
set -eo pipefail
VERB="${1:-session}"

# 자격의 두 갈래가 이 어댑터 전체를 가른다.
#   ① 기판 소유 — vault 가 MOONSHOT_API_KEY 를 주입한다 (relay.yaml llm.auth.kind: token).
#      kimi 는 그 이름을 모른다(자기 env 는 KIMI_API_KEY) — 네이티브 config 로의 번역이 어댑터 몫이다
#   ② 도구 소유 — 사용자가 kimi login 으로 만든 자격이 kimi 의 집(config)에 앉는다
# ① 이 정본이라 login 동사가 없다: 화면은 토큰 입력창을 띄워 vault 에 넣는다.
# info.verbs 에 login 을 싣지 않는 이유이고, 싣는 순간 화면은 열 수 없는 로그인 버튼을 그린다
KIMI_HOME="${KIMI_SHARE_DIR:-$HOME/.kimi}"
# 국제(api.moonshot.ai)와 중국(api.moonshot.cn)은 키가 호환되지 않는 별개 플랫폼이다
MOONSHOT_BASE="${MOONSHOT_BASE_URL:-https://api.moonshot.ai/v1}"

# 도구 소유 자격 실측 — kimi login 은 config 의 provider api_key 자리에 앉고 logout 이 그 자리를 비운다
tool_cred() {
  for f in "$KIMI_HOME/config.toml" "$KIMI_HOME/config.json"; do
    if [ -f "$f" ] && grep -qE 'api_key[[:space:]]*[=:][[:space:]]*"[^"]+"' "$f"; then return 0; fi
  done
  return 1
}

case "$VERB" in
  info)
    ACCOUNT='null'
    if [ -n "${MOONSHOT_API_KEY:-}" ]; then
      ACCOUNT='{"method":"token","provider":"moonshot"}'
    elif tool_cred; then
      ACCOUNT='{"method":"kimi login"}'
    fi
    # capabilities 는 물리적 능력만이다. vision·effort 는 선언하지 않는다 —
    # 이미지 입력은 모델 쪽 capabilities(image_in) 소관이라 하네스가 보장할 수 없고,
    # kimi 의 노력 축은 --thinking 온오프뿐인데 모델이 그걸 지원하지 않으면 세션이 죽는다
    echo '{"name":"kimi","provider":"moonshot","protocol":2,"verbs":["session","setup","models","commands","info"],"capabilities":["cancel","resume"],"account":'"$ACCOUNT"'}'
    exit 0
    ;;
  setup)
    # 종료코드가 미준비의 축을 가른다: 3 = 도구 없음(설치), 그 외 비0 = 자격 없음(토큰 입력).
    # 뭉뚱그리면 도구가 없는 사용자에게 토큰 입력창이 떠서 헛돈다
    if ! command -v kimi >/dev/null 2>&1; then
      echo "kimi CLI 없음: uv tool install kimi-cli"
      exit 3
    fi
    # 실행이 깨진 설치도 도구 축이다 — 처방이 재설치이지 토큰 입력이 아니므로 3 으로 답한다
    if ! VER="$(kimi --version 2>&1)"; then
      echo "kimi 실행 실패 (설치가 깨졌습니다: uv tool install --force kimi-cli): ${VER%%$'\n'*}"
      exit 3
    fi
    VER="${VER%%$'\n'*}"
    if [ -n "${MOONSHOT_API_KEY:-}" ]; then
      echo "$VER"
      echo "moonshot 토큰 자격 연결됨 · $MOONSHOT_BASE"
      exit 0
    fi
    if tool_cred; then
      echo "$VER"
      echo "kimi 자체 로그인 자격 사용 ($KIMI_HOME)"
      exit 0
    fi
    echo "$VER"
    echo "MOONSHOT_API_KEY 없음: relay connect llm moonshot 으로 토큰을 넣으세요 (또는 터미널에서 kimi login)"
    exit 1
    ;;
  models)
    # 정본 = Moonshot /v1/models (기판 자격). 자격이 도구 손이면 kimi 가 아는 모델 키(config 의 models)로
    # 강등한다 — --model 이 받는 어휘가 바로 그 키다. 둘 다 없으면 안내 항목 하나로 강등하고 사유는 stderr 에.
    # 하드코딩 id 는 폴백에 쓰지 않는다: 예전 폴백이던 kimi-latest 는 2026-01-28 단종됐고,
    # 낡은 목록이 정본 행세를 하면 사용자가 없는 모델을 고른다
    KIMI_HOME="$KIMI_HOME" MOONSHOT_BASE="$MOONSHOT_BASE" node --input-type=module -e '
import fs from "node:fs";
const out = (xs) => process.stdout.write(JSON.stringify([...new Set(xs)]));

function configModels() {
  const home = process.env.KIMI_HOME;
  try {
    const toml = fs.readFileSync(home + "/config.toml", "utf8");
    return [...toml.matchAll(/^[ \t]*\[models\.(?:"([^"]+)"|([^\]\s]+))\]/gm)].map((m) => m[1] ?? m[2]);
  } catch { /* toml 없음 — json 으로 */ }
  try {
    return Object.keys(JSON.parse(fs.readFileSync(home + "/config.json", "utf8"))?.models ?? {});
  } catch { return []; }
}
const degrade = (why) => {
  process.stderr.write("models 강등 — " + why + "\n");
  const keys = configModels();
  out(keys.length ? keys : ["(MOONSHOT_API_KEY 를 연결하면 모델 목록이 여기 나옵니다)"]);
};

const key = process.env.MOONSHOT_API_KEY;
if (!key) { degrade("MOONSHOT_API_KEY 없음 — kimi 자체 설정의 모델 키로 대신한다"); process.exit(0); }
try {
  const res = await fetch(process.env.MOONSHOT_BASE + "/models", {
    headers: { Authorization: "Bearer " + key },
    signal: AbortSignal.timeout(8000),
  });
  if (!res.ok) throw new Error(String(res.status));
  const j = await res.json();
  const ids = (Array.isArray(j?.data) ? j.data : [])
    .filter((m) => m && typeof m.id === "string" && m.id)
    .sort((a, b) => Number(b.created ?? 0) - Number(a.created ?? 0))
    .map((m) => m.id);
  if (ids.length) out(ids);
  else degrade("API 응답에 모델이 없음");
} catch (e) {
  degrade("API 조회 실패: " + (e?.message ?? e));
}'
    exit 0
    ;;
  commands)
    # kimi 내장 슬래시 커맨드(TTY 전용). 이 workdir 에 조립된 패키지 커맨드는 기판이 병합한다.
    # /model 은 싣지 않는다 — 기판 자격 세션은 --config-file 로 뜨고 그때 kimi 가 /model 을 막는다.
    # 모델 선택의 정본은 relay model <패키지> <이름> 이다
    echo '[{"name":"compact","description":"대화를 압축해 컨텍스트를 줄인다","tty":true},
 {"name":"clear","description":"대화 문맥을 비운다","tty":true},
 {"name":"new","description":"새 세션을 만들어 바로 옮겨간다","tty":true},
 {"name":"sessions","description":"이 디렉토리의 세션 목록에서 고른다","tty":true},
 {"name":"undo","description":"이전 턴으로 되돌려 다시 시도한다","tty":true},
 {"name":"add-dir","description":"작업 범위에 디렉토리를 추가한다","tty":true},
 {"name":"mcp","description":"연결된 MCP 서버와 도구를 본다","tty":true},
 {"name":"plan","description":"플랜 모드를 켜고 끈다","tty":true},
 {"name":"task","description":"백그라운드 작업 목록을 본다","tty":true},
 {"name":"init","description":"프로젝트를 분석해 AGENTS.md 를 만든다","tty":true}]'
    exit 0
    ;;
  session)
    ;;
  *)
    echo "지원하지 않는 동사: $VERB (session|setup|models|commands|info)"
    exit 2
    ;;
esac

B="$RELAY_BUNDLE"

# 조립은 전부 플래그다 — cwd(workspace)에도 사용자의 kimi 집에도 쓰지 않는다.
# 지침 주입 경로는 --agent-file 이다: extend: default 로 도구 목록을 물려받고 시스템 프롬프트만 갈아끼운다.
# 페르소나 본문은 system_prompt_args 의 값으로 넘긴다 — 템플릿 소스가 아니라 데이터라서
# 본문에 ${...} 나 {% %} 가 들어 있어도 치환에 말려들지 않는다.
# 대신 내장 프롬프트 자리를 우리 것이 차지하므로, 문서화된 컨텍스트 변수는 템플릿에서 직접 다시 심는다
B="$B" node --input-type=module -e '
import fs from "node:fs";
const B = process.env.B;
const meta = JSON.parse(fs.readFileSync(B + "/meta.json", "utf8"));

let doc = fs.readFileSync(B + "/persona.md", "utf8");
doc += "\n\n# 기판 (Relay)\n"
  + "- 작업 무대(cwd): " + (meta.workspace ?? process.cwd()) + "\n"
  + "- 파일 교환 무대: " + meta.stage + " — 사용자에게 채팅으로 전달할 파일은 여기 놓는다. 첨부도 여기서 온다\n"
  + "- 접근 금지: " + (meta.hooks?.deny ?? []).join(", ") + " — 읽지도 쓰지도 마라\n";

// 서브에이전트 위임 — 기판 소유(2026-08-20 단일화, harness-protocol §subagents). kimi 의
// 네이티브 subagents 선언은 쓰지 않는다(조립 표면만 커진다) — relay MCP 의 agent_dispatch 로 간다
for (const a of meta.agents ?? []) {
  const p = B + "/agents/" + a.name + ".md";
  if (!fs.existsSync(p)) continue;
  const first = fs.readFileSync(p, "utf8").split("\n").find((l) => l.trim()) ?? "";
  doc += "\n\n# 위임 가능: " + a.name + "\n" + (first ? first.trim() + "\n" : "")
    + "이 역할의 일은 직접 하지 말고 relay 의 agent_dispatch 도구로 위임하라 — "
    + "별도 세션에서 돌고 완료 결과가 돌아온다. 맥락은 공유되지 않으니 지시에 필요한 배경을 담아라.\n";
}
// 커맨드도 문서 절이다. kimi 의 슬래시 커맨드는 내장 집합이라 사용자 커맨드를 등록할 자리가 없고,
// 문서 절은 TTY 와 headless 양쪽에서 똑같이 동작한다
if (fs.existsSync(B + "/commands")) {
  for (const f of fs.readdirSync(B + "/commands").filter((x) => x.endsWith(".md"))) {
    doc += "\n\n# 커맨드: /" + f.replace(/\.md$/, "") + "\n사용자 메시지가 이 커맨드면 아래 지시를 따른다.\n\n" + fs.readFileSync(B + "/commands/" + f, "utf8");
  }
}

fs.writeFileSync(B + "/kimi-system.md", [
  "${RELAY_DOC}",
  "",
  "# 무대",
  "- 작업 디렉토리: ${KIMI_WORK_DIR}",
  "- 현재 시각: ${KIMI_NOW}",
  "${KIMI_ADDITIONAL_DIRS_INFO}",
  "",
  "# 스킬",
  "${KIMI_SKILLS}",
  "",
  "# 프로젝트 지침",
  "${KIMI_AGENTS_MD}",
  "",
].join("\n"));

// JSON 은 YAML 의 부분집합이라 그대로 에이전트 파일이 된다. system_prompt_path 는 이 파일 기준 상대경로다
fs.writeFileSync(B + "/kimi-agent.yaml", JSON.stringify({
  version: 1,
  agent: {
    extend: "default",
    name: "relay-" + String(meta.pkg).replace(/[^a-zA-Z0-9-]/g, "-"),
    system_prompt_path: "./kimi-system.md",
    system_prompt_args: { RELAY_DOC: doc },
  },
}, null, 2));

fs.writeFileSync(B + "/mcp.kimi.json", JSON.stringify({
  mcpServers: { relay: { url: meta.mcp.url, headers: { Authorization: meta.mcp.authorization } } },
}));
'

# 같은 RELAY_SESSION 재호출 = 대화 이어가기. kimi 의 --session 은 없는 id 면 새로 만들고 있으면 이어가므로
# 슬롯 키에서 결정론적으로 만든 이 값이 그대로 네이티브 세션 id 다 (resume capability 의 실체)
SID="relay-$(echo "$RELAY_NAME-$RELAY_SESSION" | tr -c 'a-zA-Z0-9-\n' '-')"

ARGS=(
  --agent-file "$B/kimi-agent.yaml"
  --mcp-config-file "$B/mcp.kimi.json"
  --session "$SID"
)
# --skills-dir 는 자동 탐색(사용자·프로젝트 스킬)을 대체한다 — 번들 스킬만 남고 개인 스킬은 섞이지 않는다
if [ -d "$B/skills" ]; then
  ARGS+=(--skills-dir "$B/skills")
fi

MODEL="${RELAY_MODEL:-}"
if [ -n "${MOONSHOT_API_KEY:-}" ]; then
  # 자격이 기판 손이면 설정도 기판 것이다: 도구의 집을 번들로 옮겨 사용자의 MCP·세션·설정이
  # 이 세션에 새어들지 않게 하고, provider 를 우리 키로 정의한다.
  # 자격이 도구 손일 때 이 격리를 켜면 그 자격에 닿지 못해 세션이 죽으므로 갈래를 나눈다
  export KIMI_SHARE_DIR="$B/kimi"
  mkdir -p "$KIMI_SHARE_DIR"

  # --model 은 config 의 models 키를 받는다. 이 갈래에서는 그 키를 우리가 API id 로 쓰므로
  # models 동사가 낸 목록과 어휘가 같다. 모델 미지정이면 조회해서 최신 하나를 고르고 번들에 적어 둔다
  if [ -z "$MODEL" ]; then
    if [ -f "$B/kimi-model" ]; then
      MODEL="$(cat "$B/kimi-model")"
    else
      MODEL="$("$0" models 2>/dev/null | node --input-type=module -e '
let d = "";
process.stdin.on("data", (c) => (d += c));
process.stdin.on("end", () => {
  let a = [];
  try { a = JSON.parse(d); } catch { /* 목록 아님 */ }
  const m = (Array.isArray(a) ? a : []).find((x) => typeof x === "string" && x && !x.startsWith("("));
  process.stdout.write(m ?? "");
});' || true)"
      if [ -n "$MODEL" ]; then printf '%s' "$MODEL" > "$B/kimi-model"; fi
    fi
  fi
  if [ -z "$MODEL" ]; then
    echo "모델을 정할 수 없습니다 (Moonshot 모델 조회 실패) — relay model <패키지> <이름> 으로 지정하세요" >&2
    exit 1
  fi

  # 토큰은 파일로만 건넨다 — --config 로 넘기면 명령줄(ps)에 자격이 노출된다
  B="$B" MODEL="$MODEL" MOONSHOT_BASE="$MOONSHOT_BASE" node --input-type=module -e '
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
const B = process.env.B;
const model = process.env.MODEL;
const meta = JSON.parse(fs.readFileSync(B + "/meta.json", "utf8"));

// hooks.deny 번역: kimi 는 권한 규칙이 없고 PreToolUse 훅뿐이라 가드 하나로 옮긴다.
// 문자열 검사가 섞인 가드레일이지 샌드박스가 아니다. 홈 하위 경로는 절대형·~형·$HOME 형을 다 니들로 만든다
const deny = meta.hooks?.deny ?? [];
const home = os.homedir();
const abs = deny.map((p) => path.resolve(p.startsWith("~") ? home + p.slice(1) : p));
const needles = [...new Set(abs.flatMap((a) => (a.startsWith(home) ? [a, "~" + a.slice(home.length), "$HOME" + a.slice(home.length)] : [a])))];
const guard = B + "/kimi-deny-guard.mjs";
fs.writeFileSync(guard, [
  "import { resolve } from \"node:path\";",
  "const DENY_ABS = " + JSON.stringify(abs) + ";",
  "const NEEDLES = " + JSON.stringify(needles) + ";",
  "let d = \"\";",
  "process.stdin.on(\"data\", (c) => (d += c));",
  "process.stdin.on(\"end\", () => {",
  "  let input = {};",
  "  try { input = JSON.parse(d).tool_input ?? {}; } catch {}",
  "  for (const k of [\"path\", \"file_path\", \"directory\"]) {",
  "    if (typeof input[k] !== \"string\") continue;",
  "    const r = resolve(process.cwd(), input[k]);",
  "    if (DENY_ABS.some((a) => r === a || r.startsWith(a + \"/\"))) block(r);",
  "  }",
  "  const cmd = typeof input.command === \"string\" ? input.command : \"\";",
  "  const hit = NEEDLES.find((n) => cmd.includes(n));",
  "  if (hit) block(hit);",
  "  process.exit(0);",
  "});",
  // 종료코드 2 = 차단, stderr 가 교정 사유로 LLM 에 돌아간다. 그 외 코드는 허용으로 흘러간다
  "function block(what) {",
  "  process.stderr.write(\"relay 담장: \" + what + \" 는 이 세션에서 접근 금지\");",
  "  process.exit(2);",
  "}",
].join("\n"));

// max_context_size 는 필수인데 /v1/models 가 알려주지 않는다. id 에 창 크기가 박힌 계열
// (moonshot-v1-128k)은 그 값을 쓰고, 나머지는 kimi-k2 계열 문서값을 기본으로 둔다
const win = /[-.](\d+)k$/i.exec(model);
fs.writeFileSync(B + "/kimi-config.json", JSON.stringify({
  default_model: model,
  providers: { "relay-moonshot": { type: "kimi", base_url: process.env.MOONSHOT_BASE, api_key: process.env.MOONSHOT_API_KEY } },
  models: { [model]: { provider: "relay-moonshot", model, max_context_size: win ? Number(win[1]) * 1024 : 262144 } },
  ...(deny.length ? { hooks: [{ event: "PreToolUse", command: "node " + JSON.stringify(guard), timeout: 10 }] } : {}),
}, null, 2), { mode: 0o600 });
'
  ARGS+=(--config-file "$B/kimi-config.json")
fi
if [ -n "$MODEL" ]; then
  ARGS+=(--model "$MODEL")
fi

if [ $# -le 1 ] || [ -z "${2:-}" ]; then
  exec kimi "${ARGS[@]}"
fi

# Windows: node 의 spawn 은 PATH 의 확장자 없는 shim 이나 .cmd 를 실행하지 못하고 ENOENT 로
# 즉사한다(#4 실측 — claude-code 어댑터와 같은 처방). 실행 계획을 여기서 정한다:
# 오버라이드 env → 진짜 .exe 직접(uv tool install 은 실체 .exe 를 깐다) → sh shim 은 bash 로 감쌈.
# 판정 불능은 조용히 넘기지 않는다 — 죽을 것이 확실한 값으로 강등하는 대신 여기서 판정한다
KIMI_BIN="${RELAY_KIMI_BIN:-kimi}"
KIMI_SHIM=""
if [ -z "${RELAY_KIMI_BIN:-}" ]; then
  case "$OSTYPE" in
    msys*|cygwin*)
      SHIM="$(command -v kimi || true)"
      case "$SHIM" in
        "")
          echo "kimi CLI 없음: uv tool install kimi-cli" >&2
          exit 3
          ;;
        /*.exe) KIMI_BIN="$(cygpath -w "$SHIM")" ;;
        /*)
          KIMI_BIN="$(cygpath -w "$(command -v bash)")"
          KIMI_SHIM="$SHIM"
          ;;
        *)
          echo "kimi 해석 불능 — command -v 가 절대경로가 아닌 값을 냈습니다: $SHIM" >&2
          exit 3
          ;;
      esac
      ;;
  esac
fi

# 세션 봉투(protocol 2): kimi 의 print 모드 stream-json 을 relay 이벤트로 번역한다.
# 줄 형식이 대화 메시지 그대로라({role:assistant|tool}) 세션 id 도 usage 도 실려 오지 않는다 —
# session 은 우리가 준 --session 값(네이티브 id), usage 는 null 이다. 없는 장부를 지어내지 않는다.
# stdin 은 제어 채널 — {"type":"cancel"} 이면 도구를 끊고 실패로 종결한다
B="$B" SID="$SID" MODEL="$MODEL" KIMI_BIN="$KIMI_BIN" KIMI_SHIM="$KIMI_SHIM" exec node --input-type=module -e '
import { spawn } from "node:child_process";
import fs from "node:fs";
import readline from "node:readline";
const B = process.env.B;
const prompt = process.argv[1];
const args = process.argv.slice(2);
const emit = (o) => process.stdout.write(JSON.stringify(o) + "\n");
const errLog = fs.createWriteStream(B + "/stderr.log", { flags: "a" });
// --print 는 --afk 를 함께 켠다(무인 승인). 승인 대기로 멈추면 headless 턴이 영영 안 끝난다.
// 실행 계획은 bash 가 정했다: KIMI_BIN(실행 파일) + 선택적 KIMI_SHIM(bash 로 읽는 shim)
const shim = process.env.KIMI_SHIM ? [process.env.KIMI_SHIM] : [];
const child = spawn(process.env.KIMI_BIN || "kimi", [
  ...shim,
  "--print",
  "--output-format", "stream-json",
  "-p", prompt,
  ...args,
], { stdio: ["ignore", "pipe", "pipe"] });
// spawn 실패(ENOENT 등)는 close 가 오지 않는다 — 방치하면 uncaught 로 죽어 계약이 깨진다
child.on("error", (e) => {
  emit({ event: "error", message: "kimi 실행 실패: " + (e?.message ?? e) });
  process.exit(1);
});
child.stderr.pipe(errLog);
process.on("SIGTERM", () => child.kill("SIGTERM"));

let last = null;
let cancelled = false;
const tools = new Map(); // tool_call_id -> name (tool 메시지와 짝맞춤용)
const asText = (c) => typeof c === "string" ? c
  : Array.isArray(c) ? c.filter((b) => b?.type === "text").map((b) => b.text ?? "").join("")
  : "";

const rl = readline.createInterface({ input: child.stdout });
rl.on("line", (line) => {
  let j;
  try { j = JSON.parse(line); } catch { return; }
  if (j.role === "assistant") {
    const t = asText(j.content);
    if (t) { emit({ event: "delta", text: t }); last = t; }
    for (const c of j.tool_calls ?? []) {
      const name = c?.function?.name ?? "tool";
      tools.set(c.id, name);
      let d = "";
      try {
        const a = JSON.parse(c?.function?.arguments ?? "{}");
        d = a.command ?? a.path ?? a.pattern ?? a.url ?? "";
      } catch { /* 인자가 JSON 이 아님 — 상세 없이 진행만 알린다 */ }
      emit({ event: "tool", name, status: "start", ...(d ? { detail: String(d).slice(0, 200) } : {}) });
    }
  } else if (j.role === "tool" && tools.has(j.tool_call_id)) {
    emit({ event: "tool", name: tools.get(j.tool_call_id), status: "end" });
    tools.delete(j.tool_call_id);
  }
});

const ctl = readline.createInterface({ input: process.stdin });
ctl.on("line", (line) => {
  try {
    if (JSON.parse(line).type === "cancel") {
      cancelled = true;
      child.kill("SIGTERM");
    }
  } catch { /* 제어 아님 — 무시 */ }
});

child.on("close", (code) => {
  rl.close();
  ctl.close();
  process.stdin.destroy();
  // 마지막 assistant 메시지가 종결 응답이다(--final-message-only 가 남기는 그 줄)
  if (last !== null && !cancelled) {
    emit({ event: "reply", text: last, session: process.env.SID, model: process.env.MODEL || null, usage: null });
    if (code !== 0) process.exitCode = code; // 사유는 text 로 갔고 실패는 종료코드로
    return;
  }
  let tail = "";
  try { tail = fs.readFileSync(B + "/stderr.log", "utf8").trim().split("\n").slice(-3).join(" / "); } catch { /* 로그 없음 */ }
  // kimi 의 print 종료코드: 0 성공 · 75 일시 오류(재시도 가능) · 그 외 영구 오류
  const why = code === 75 ? "일시 오류라 재시도할 만하다" : "영구 오류";
  emit({ event: "error", message: cancelled ? "취소됨" : "kimi 응답 없음 (exit " + code + ") — " + why + (tail ? " — " + tail : "") });
  process.exitCode = cancelled ? 130 : 1;
});
' "$2" "${ARGS[@]}"
