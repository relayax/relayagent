#!/bin/bash
set -eo pipefail
VERB="${1:-session}"

case "$VERB" in
  info)
    LOGIN=""
    EFFORT=0
    if command -v claude >/dev/null 2>&1; then
      # auth status 는 미로그인일 때도 JSON 을 내고 종료코드 1 로 끝난다(도구 소스 실증).
      # 여기에 `|| echo {}` 를 붙이면 두 JSON 이 이어붙어 파싱이 터지고 info 가 통째로 침묵한다 —
      # 로그인 안 한 사용자가 하네스를 설치조차 못 하게 된다. stdout 만 취하고 파싱은 관대하게
      LOGIN="$(claude auth status --json 2>/dev/null || true)"
      # capabilities 는 물리적 능력만 — effort 는 CLI 가 실제로 아는 경우에만 선언한다
      if claude --help 2>/dev/null | grep -q -- '--effort'; then EFFORT=1; fi
    fi
    LOGIN="$LOGIN" EFFORT="$EFFORT" node --input-type=module -e '
let a = {};
try { a = JSON.parse(process.env.LOGIN || "{}"); } catch { /* 형식이 바뀌면 계정 미상으로 강등 */ }
const caps = ["cancel", "vision", "resume"];
if (process.env.EFFORT === "1") caps.push("effort");
process.stdout.write(JSON.stringify({
  name: "claude-code",
  provider: "anthropic",
  protocol: 2,
  verbs: ["session", "serve", "setup", "login", "models", "commands", "info"],
  capabilities: caps,
  account: a.loggedIn ? { email: a.email ?? null, plan: a.subscriptionType ?? null, method: a.authMethod ?? null } : null,
}));'
    exit 0
    ;;
  setup)
    # 종료코드가 미준비의 축이다: 0 준비됨 · 3 도구 없음 · 그 외 비0 자격 없음
    if ! command -v claude >/dev/null 2>&1; then
      echo "claude CLI 없음: npm install -g @anthropic-ai/claude-code"
      exit 3
    fi
    VER="$(claude --version 2>/dev/null | head -1)"
    ST="$(claude auth status --json 2>/dev/null || true)"
    if ! ST="$ST" VER="$VER" node --input-type=module -e '
let a = {};
try { a = JSON.parse(process.env.ST || "{}"); } catch { /* 파싱 실패 = 자격을 확인하지 못함 */ }
if (!a.loggedIn) {
  process.stdout.write("로그인 필요: relay login <패키지> 를 실행하세요 (구독 로그인)");
  process.exit(1);
}
const who = [a.email, a.subscriptionType && a.subscriptionType + " 플랜", a.authMethod].filter(Boolean).join(" · ");
process.stdout.write(process.env.VER + "\n" + who);'; then
      exit 1
    fi
    exit 0
    ;;
  login)
    # 처방(쓰기) — setup 이 진단이라면 이쪽이 치료다. 대화형이라 TTY 를 그대로 물려받는다.
    #   기본: 구독 로그인(claude auth login). 이미 로그인돼 있어도 계정 전환 경로다
    #   --switch: 기존 자격을 비우고 다시 로그인 (계정 갈아타기)
    #   --token: 장기 토큰 발급(claude setup-token) — 그 값은 사용자가 relay connect 로 vault 에 넣는다
    #
    # headless 로그인 적합성(기판이 pty 로 감싸 출력·입력을 화면과 중계한다):
    # claude auth login 은 선택 메뉴 없이 평문 세 줄(Opening browser… / If the browser didn't
    # open, visit: <URL> / Paste code here if prompted > )을 stdout 에 쓰고 readline 으로
    # 줄 단위 stdin 을 받는다. 전체화면 TUI 도 raw key 도 쓰지 않으므로 중계로 성립한다.
    # 로그인 방식은 무플래그 기본이 구독(claudeai)이다 — 메뉴가 뜨지 않는다.
    # 반면 setup-token 은 Ink 전체화면이라 중계로 못 쓴다: --token 은 사람이 보는 터미널 전용이다
    if ! command -v claude >/dev/null 2>&1; then
      echo "claude CLI 없음: npm install -g @anthropic-ai/claude-code"
      exit 3
    fi
    if [ "${2:-}" = "--token" ]; then
      exec claude setup-token
    fi
    # 로그아웃 없이 login 만 부르면 도구가 "이미 로그인됨" 으로 끝나 전환이 안 되는 구현이 있다.
    # 전환은 명시 동작이므로 자격을 먼저 비운다
    if [ "${2:-}" = "--switch" ]; then
      claude auth logout >/dev/null 2>&1 || true
    fi
    exec claude auth login
    ;;
  models)
    # 정본 = Anthropic /v1/models. 자격이 기판 손(ANTHROPIC_API_KEY)에 있을 때만 닿는다 —
    # 구독 로그인 자격은 도구가 Keychain 에 쥐고 있어 여기서 빌려 쓰지 않는다.
    # 강등은 도구가 스스로 문서화한 별칭(--help 의 --model 예시)까지만이다. 어댑터 소스에
    # 어휘를 하드코딩하면 CLI 버전과 어긋난 항목이 정본 행세를 한다 — fable 을 별칭 목록에
    # 박았다가 그 별칭을 모르는 CLI(2.1.153)가 세션마다 404 로 죽은 실사고(2026-08-07).
    # 그마저 못 읽으면 다음 한 걸음을 적은 안내 항목 하나로 강등한다(빈 목록 금지)
    HELP="$(claude --help 2>/dev/null || true)"
    HELP="$HELP" node --input-type=module -e '
const out = (xs) => process.stdout.write(JSON.stringify([...new Set(xs)]));
const degrade = (why, xs) => { process.stderr.write("models 강등 — " + why + "\n"); out(xs); };

// 도구 자기선언 어휘 = --help 의 --model 설명이 따옴표로 든 별칭 예시.
// 전체 id 예시(claude-sonnet-4-6 류)는 형식 안내이지 별칭이 아니라서 소문자 단일 단어만 취한다
function toolAliases() {
  const help = process.env.HELP ?? "";
  const at = help.indexOf("--model");
  if (at < 0) return [];
  const end = help.indexOf("\n  -", at);
  const seg = help.slice(at, end < 0 ? undefined : end);
  return [...seg.matchAll(/\x27([a-z]+)\x27/g)].map((m) => m[1]);
}
const ALIAS = toolAliases();
const GUIDE = ["(모델 id 직접 입력 — ANTHROPIC_API_KEY 연결 시 전체 목록이 나옵니다)"];

const key = process.env.ANTHROPIC_API_KEY;
if (!key) {
  if (ALIAS.length) degrade("ANTHROPIC_API_KEY 없음 — 도구가 문서화한 별칭만 노출한다", ALIAS);
  else degrade("ANTHROPIC_API_KEY 없음, 도구의 별칭 문서도 못 읽음", GUIDE);
  process.exit(0);
}

try {
  const res = await fetch("https://api.anthropic.com/v1/models?limit=100", {
    headers: { "anthropic-version": "2023-06-01", "x-api-key": key },
    signal: AbortSignal.timeout(8000),
  });
  if (!res.ok) throw new Error(String(res.status));
  const j = await res.json();
  const ids = (Array.isArray(j?.data) ? j.data : [])
    .filter((m) => m && typeof m.id === "string" && m.id)
    .sort((a, b) => String(b.created_at ?? "").localeCompare(String(a.created_at ?? "")))
    .map((m) => m.id);
  if (ids.length) out([...ALIAS, ...ids]);
  else degrade("API 응답에 모델이 없음", ALIAS.length ? ALIAS : GUIDE);
} catch (e) {
  degrade("API 조회 실패: " + (e?.message ?? e), ALIAS.length ? ALIAS : GUIDE);
}'
    exit 0
    ;;
  commands)
    # 하네스 내장 슬래시 커맨드 + 이 패키지에 조립된 커맨드는 기판이 병합한다.
    # tty 판정 근거는 도구가 스스로 낸 목록이다: clear·compact 는 -p 세션의 슬래시 목록에도
    # 올라오므로 headless 에서도 먹고, model·resume·status·memory 는 대화형 REPL 에만 있다
    echo '[{"name":"compact","description":"지금까지의 대화를 요약해 컨텍스트를 비운다"},
 {"name":"clear","description":"빈 컨텍스트로 새 세션을 연다 (이전 세션은 디스크에 남는다)"},
 {"name":"model","description":"이 세션의 모델을 바꾼다","tty":true},
 {"name":"resume","description":"이전 대화를 고른다","tty":true},
 {"name":"status","description":"버전·모델·계정·도구 상태를 본다","tty":true},
 {"name":"context","description":"컨텍스트 사용량을 본다","tty":true},
 {"name":"memory","description":"CLAUDE.md 메모리를 연다","tty":true}]'
    exit 0
    ;;
  session|serve)
    ;;
  *)
    echo "지원하지 않는 동사: $VERB (session|serve|setup|login|models|commands|info)"
    exit 2
    ;;
esac

B="$RELAY_BUNDLE"

# 조립은 전부 플래그로 넣는다 — cwd(workspace)도, 사용자의 ~/.claude 도 건드리지 않는다.
#
# CLAUDE_CONFIG_DIR 격리는 쓰지 않는다: 구독 로그인 자격은 도구 소유(Keychain)이고 설정
# 디렉토리를 옮기면 그 자격에 닿지 못해 "Not logged in" 으로 죽는다(2026-08-06 실증).
# 자격이 기판 손에 있는 경우(ANTHROPIC_API_KEY)에만 격리가 성립하므로 그때만 켠다
if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  CFG="$B/claude"
  mkdir -p "$CFG"
  [ -f "$CFG/.claude.json" ] || echo '{"hasCompletedOnboarding":true}' > "$CFG/.claude.json"
  export CLAUDE_CONFIG_DIR="$CFG"
fi

B="$B" node --input-type=module -e '
import fs from "node:fs";
import path from "node:path";
import os from "node:os";
const B = process.env.B;
const meta = JSON.parse(fs.readFileSync(B + "/meta.json", "utf8"));

// ① 시스템 프롬프트 = persona + 기판 문맥(무대, 담장). append 라 도구 사용 지침은 살아 있다
let doc = fs.readFileSync(B + "/persona.md", "utf8");
doc += "\n\n# 기판 (Relay)\n"
  + "- 작업 무대(cwd): " + (meta.workspace ?? process.cwd()) + "\n"
  + "- 파일 교환 무대: " + meta.stage + " — 사용자에게 채팅으로 전달할 파일은 여기 놓는다. 첨부도 여기서 온다\n"
  + "- 접근 금지: " + (meta.hooks?.deny ?? []).join(", ") + " — 도구 호출이 차단된다\n";
fs.writeFileSync(B + "/system.md", doc);

// ② 스킬·커맨드 = 플러그인 디렉토리. 사용자의 ~/.claude 나 cwd 를 오염하지 않는 유일한 경로.
// 매니페스트 정본 위치는 .claude-plugin/plugin.json 이다 — 루트에 두면 도구가 읽지 않고
// 디렉토리 이름을 플러그인 이름으로 삼아 커맨드 접두가 통째로 어긋난다(2026-08-06 실측)
const plugin = "relay-" + String(meta.pkg).replace(/[^a-zA-Z0-9-]/g, "-");
const PL = path.join(B, "plugin");
fs.rmSync(PL, { recursive: true, force: true });
fs.mkdirSync(path.join(PL, ".claude-plugin"), { recursive: true });
fs.writeFileSync(path.join(PL, ".claude-plugin", "plugin.json"), JSON.stringify({
  name: plugin,
  version: "0.1.0",
  description: meta.pkg + " 패키지 번들",
}));
for (const sub of ["skills", "commands"]) {
  if (fs.existsSync(path.join(B, sub))) fs.cpSync(path.join(B, sub), path.join(PL, sub), { recursive: true });
}

// 플러그인 커맨드는 <플러그인>:<이름> 으로만 풀린다 — 선언 이름 그대로 부르면 Unknown command 다.
// 기판 화면은 선언 이름을 보여주므로 headless 진입에서 선두 /이름 을 접두 붙여 번역한다.
// 그 사전이 slash.json 이다 (TTY 는 도구 자동완성이 접두형을 그대로 보여주므로 손대지 않는다)
const cmdDir = path.join(B, "commands");
const names = fs.existsSync(cmdDir)
  ? fs.readdirSync(cmdDir).filter((f) => f.endsWith(".md")).map((f) => f.slice(0, -3))
  : [];
fs.writeFileSync(B + "/slash.json", JSON.stringify({ prefix: plugin, names }));

// ③ 서브에이전트 = --agents JSON (frontmatter 파일 대신 인자로)
const agents = {};
for (const a of meta.agents ?? []) {
  const src = path.join(B, "agents", a.name + ".md");
  if (!fs.existsSync(src)) continue;
  agents[a.name] = { description: a.description, prompt: fs.readFileSync(src, "utf8") };
}
fs.writeFileSync(B + "/agents.json", JSON.stringify(agents));

fs.writeFileSync(B + "/mcp.claude.json", JSON.stringify({
  mcpServers: { relay: { type: "http", url: meta.mcp.url, headers: { Authorization: meta.mcp.authorization } } },
}));

// hooks.deny 번역: 파일 도구 전계열은 권한 deny 규칙으로, 전 도구는 PreToolUse 가드로 이중으로 막는다.
// 훅은 permission mode 와 무관하게 돌므로 headless 의 skip-permissions 에서도 산다
const deny = meta.hooks?.deny ?? [];
const home = os.homedir();
const abs = deny.map((p) => path.resolve(p.startsWith("~") ? home + p.slice(1) : p));
const rule = (p) => (p.startsWith("~") ? p : "/" + p.replace(/^\/+/, "")) + "/**";
fs.writeFileSync(B + "/settings.json", JSON.stringify({
  permissions: { deny: deny.flatMap((p) => ["Read(" + rule(p) + ")", "Edit(" + rule(p) + ")"]) },
  hooks: { PreToolUse: [{ matcher: ".*", hooks: [{ type: "command", command: "node " + JSON.stringify(path.join(B, "deny-guard.mjs")) }] }] },
}, null, 2));

// Bash 검사는 문자열 휴리스틱이라 우회 여지가 있다 — 가드레일이지 샌드박스가 아니다.
// 홈 하위 경로는 절대형·~형·$HOME 형 세 표기를 전부 니들로 만든다
const needles = [...new Set(abs.flatMap((a) => (a.startsWith(home) ? [a, "~" + a.slice(home.length), "$HOME" + a.slice(home.length)] : [a])))];
fs.writeFileSync(B + "/deny-guard.mjs", [
  "import { resolve } from \"node:path\";",
  "const DENY_ABS = " + JSON.stringify(abs) + ";",
  "const NEEDLES = " + JSON.stringify(needles) + ";",
  "let d = \"\";",
  "process.stdin.on(\"data\", (c) => (d += c));",
  "process.stdin.on(\"end\", () => {",
  "  let input = {};",
  "  try { input = JSON.parse(d).tool_input ?? {}; } catch {}",
  "  for (const k of [\"file_path\", \"path\", \"notebook_path\"]) {",
  "    if (typeof input[k] !== \"string\") continue;",
  "    const r = resolve(process.cwd(), input[k]);",
  "    if (DENY_ABS.some((a) => r === a || r.startsWith(a + \"/\"))) block(r);",
  "  }",
  "  const cmd = typeof input.command === \"string\" ? input.command : \"\";",
  "  const hit = NEEDLES.find((n) => cmd.includes(n));",
  "  if (hit) block(hit);",
  "  process.exit(0);",
  "});",
  "function block(what) {",
  "  process.stderr.write(\"relay 담장: \" + what + \" 는 이 세션에서 접근 금지\");",
  "  process.exit(2);",
  "}",
].join("\n"));
'

# setting-sources 를 비우면 사용자 개인 설정(~/.claude 의 스킬·커맨드·에이전트·메모리)이 배제된다 —
# 자격은 그대로 살아 있다(실측: apiKeySource none 으로도 구독 세션이 성립). 이것이 자격을 끊지
# 않으면서 얻는 유일한 격리다. strict-mcp-config 는 사용자의 MCP 서버가 섞이지 않게 한다
ARGS=(
  --mcp-config "$B/mcp.claude.json"
  --strict-mcp-config
  --setting-sources ""
  --settings "$B/settings.json"
  --append-system-prompt-file "$B/system.md"
  --plugin-dir "$B/plugin"
)
if [ -s "$B/agents.json" ] && [ "$(cat "$B/agents.json")" != "{}" ]; then
  ARGS+=(--agents "$(cat "$B/agents.json")")
fi
if [ -n "${RELAY_MODEL:-}" ]; then
  ARGS+=(--model "$RELAY_MODEL")
fi
# 모르는 강도는 무시한다 — 그대로 흘리면 도구가 인자를 거부해 세션이 통째로 죽는다.
# 어휘 근거는 claude --help 의 --effort <level> (low, medium, high, xhigh, max)
if [ -n "${RELAY_EFFORT:-}" ]; then
  if ! claude --help 2>/dev/null | grep -q -- '--effort'; then
    echo "RELAY_EFFORT 무시 — 이 claude 버전은 --effort 를 모른다" >&2
  elif [[ " low medium high xhigh max " == *" $RELAY_EFFORT "* ]]; then
    ARGS+=(--effort "$RELAY_EFFORT")
  else
    echo "RELAY_EFFORT 무시 — 모르는 강도: $RELAY_EFFORT (low|medium|high|xhigh|max)" >&2
  fi
fi
# 인터랙티브 TUI — 봉투를 거치지 않는 유일한 세션 경로. 연속 포인터는 여기서만 bash 가 잇고,
# 봉투 경로(session 프롬프트·serve 상주)의 포인터는 봉투가 소유한다(죽은 포인터 복구가 봉투 관할)
if [ "$VERB" = "session" ] && { [ $# -le 1 ] || [ -z "${2:-}" ]; }; then
  if [ -f "$B/claude-session" ]; then
    ARGS+=(--resume "$(cat "$B/claude-session")")
  fi
  exec claude "${ARGS[@]}"
fi

# 세션 봉투(protocol 2): claude 의 stream-json 을 relay 이벤트로 번역한다.
# 두 모드가 한 봉투다 — session <프롬프트> 는 1턴 뒤 은퇴하고, serve 는 상주하며
# stdin 으로 턴({"type":"turn","prompt":…})을 받는다. 어느 쪽이든 stdin 은 제어 채널이라
# {"type":"cancel"} 수신 시 도구를 끊고 실패 종결을 낸다.
# 상주의 물리적 근거: -p --input-format stream-json 에서 stdin 을 열어두면 result 후에도
# 프로세스가 살고, 다음 user 프레임이 같은 대화의 다음 턴이 되며, stdin EOF 로 자연 종료한다
# (실측 2026-08-10, 2.1.153 — relayos-claude resident-session 실측과 동일). 턴 경계 = result.
# 실패를 텍스트로 위장하지 않는다: 실패는 error 이벤트 + 비0 종료코드로만 낸다
B="$B" exec node --input-type=module -e '
import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import readline from "node:readline";
const B = process.env.B;
const MODE = process.argv[1];          // "session" = 1턴 봉투 · "serve" = 상주(턴은 stdin 주입)
const baseArgs = process.argv.slice(3);
const emit = (o) => process.stdout.write(JSON.stringify(o) + "\n");

let meta = {};
try { meta = JSON.parse(fs.readFileSync(B + "/meta.json", "utf8")); } catch { /* 무대 없이도 돈다 */ }
const stage = typeof meta.stage === "string" ? path.resolve(meta.stage) : null;

// 기판 화면은 패키지 커맨드를 선언 이름으로 보여주지만 도구는 플러그인 접두로만 푼다
function translateSlash(prompt) {
  try {
    const sl = JSON.parse(fs.readFileSync(B + "/slash.json", "utf8"));
    const hit = /^\/([A-Za-z0-9][A-Za-z0-9_-]*)(?=$|\s)/.exec(prompt);
    if (hit && sl.names.includes(hit[1])) return "/" + sl.prefix + ":" + prompt.slice(1);
  } catch { /* 커맨드 없는 패키지 */ }
  return prompt;
}

const WRITERS = new Set(["Write", "Edit", "MultiEdit", "NotebookEdit"]);
const tools = new Map();          // tool_use_id -> { name, file } (end 이벤트 짝맞춤용)
let model = null;                 // 본류가 실제로 말한 모델

// 턴 상태 — 상주에서는 턴마다 새로 시작한다. null = 유휴(주입 없는 프레임은 관할 밖)
let turn = null;                  // { prompt, said, filed:Set, restarted, done }

// 죽은 resume 포인터는 복구 대상이다. 가리키던 대화는 도구 보존기간 정리나 워크스페이스(cwd)
// 이동으로 사라질 수 있고, 그때 도구는 이 문구와 함께 대화 없이 즉사한다(실측 2026-08-09,
// 2.1.153). resume 의 계약은 "있으면 잇고, 없으면 새로"다 — 없는 과거가 현재 턴을 죽이면
// 그 슬롯은 사람이 포인터 파일을 지워 줄 때까지 영영 실패를 반복한다
const RESUME_GONE = "No conversation found with session ID";

let child = null;                 // claude 프로세스 — 첫 턴에 부트, 이후 stdin 주입
let resumedBoot = false;          // 이번 부트가 --resume 인가
let restarting = false;           // 이번 부트가 죽은 포인터로 끝남 — 닫히면 새 세션으로 다시 편다
let restarted = false;            // 재시도는 봉투 수명당 정확히 한 번
let cancelled = false;
let closing = false;              // 은퇴 진행 — 1턴 종결 또는 제어 채널 EOF
let killTimer = null;

function boot() {
  // 꼬리 로그는 이번 실행 것만 남긴다 — 누적하면 지난 실행 오류로 엉뚱한 진단을 낸다
  const errLog = fs.createWriteStream(B + "/stderr.log", { flags: "w" });
  const args = [...baseArgs];
  resumedBoot = false;
  try {
    const sid = fs.readFileSync(B + "/claude-session", "utf8").trim();
    if (sid) { args.push("--resume", sid); resumedBoot = true; }
  } catch { /* 첫 대화 */ }
  child = spawn("claude", [
    "-p", "--input-format", "stream-json",
    "--output-format", "stream-json", "--include-partial-messages", "--verbose",
    "--dangerously-skip-permissions",
    ...args,
  ], { stdio: ["pipe", "pipe", "pipe"] });
  child.stderr.pipe(errLog);
  const rl = readline.createInterface({ input: child.stdout });
  rl.on("line", onLine);
  child.on("close", (code) => { rl.close(); onClaudeClose(code); });
}
const relay = (sig) => process.on(sig, () => child?.kill(sig));
relay("SIGTERM");
relay("SIGINT");

function inject(prompt, opts = {}) {
  turn = { prompt, said: "", filed: new Set(), restarted: !!opts.restarted, done: false };
  if (!child) boot();
  child.stdin.write(JSON.stringify({
    type: "user",
    message: { role: "user", content: [{ type: "text", text: translateSlash(prompt) }] },
  }) + "\n");
}

// 은퇴: stream-json 입력 종료 = claude 자연 종료. 8초 안에 안 내려오면 강제
function retire() {
  closing = true;
  if (!child) process.exit(process.exitCode ?? 0);
  try { child.stdin.end(); } catch { /* 이미 닫힘 */ }
  killTimer = setTimeout(() => { try { child.kill("SIGKILL"); } catch { /* 이미 종료 */ } }, 8000);
  killTimer.unref?.();
}

const onLine = (line) => {
  let j;
  try { j = JSON.parse(line); } catch { return; }
  // 중간 텍스트는 부분 청크에서 뽑는다. 서브에이전트(parent_tool_use_id 있음)의 말은
  // 본류 답변이 아니므로 흘리지 않는다 — 섞으면 두 대화가 한 줄기로 보인다.
  // thinking_delta 도 버린다: 사고는 사용자에게 낼 중간 텍스트가 아니다.
  // 유휴(turn 없음)에 흘러오는 프레임은 이 봉투가 주입한 턴이 아니다 — 중계하지 않는다
  if (j.type === "stream_event") {
    if (!turn || j.parent_tool_use_id != null) return;
    const e = j.event;
    if (e?.type === "content_block_delta" && e.delta?.type === "text_delta" && e.delta.text) {
      turn.said += e.delta.text;
      emit({ event: "delta", text: e.delta.text });
    }
    return;
  }
  if (j.type === "assistant") {
    if (j.parent_tool_use_id == null && j.message?.model) model = j.message.model;
    if (!turn) return;
    // 텍스트 블록은 여기서 다시 내지 않는다 — 위 부분 청크와 겹친다
    for (const b of j.message?.content ?? []) {
      if (b.type !== "tool_use") continue;
      const file = [b.input?.file_path, b.input?.notebook_path].find((x) => typeof x === "string");
      tools.set(b.id, { name: b.name, file });
      const d = b.input?.command ?? file ?? b.input?.path ?? b.input?.pattern ?? b.input?.skill ?? b.input?.description ?? "";
      emit({ event: "tool", name: b.name, status: "start", ...(d ? { detail: String(d).slice(0, 200) } : {}) });
    }
  } else if (j.type === "user") {
    if (!turn) return;
    for (const b of j.message?.content ?? []) {
      if (b.type !== "tool_result" || !tools.has(b.tool_use_id)) continue;
      const t = tools.get(b.tool_use_id);
      tools.delete(b.tool_use_id);
      emit({ event: "tool", name: t.name, status: "end" });
      // 무대 산출물은 성공한 쓰기에서만 알린다. 기판도 턴 전후 diff 로 잡지만 그건 종결 뒤라
      // 진행 중 화면에는 늦다 — 이 이벤트가 그 사이를 메운다
      if (b.is_error === true || !t.file || !stage || !WRITERS.has(t.name)) continue;
      // 무대 하위의 파일만 — 무대 자신은 파일이 아니므로 sep 까지 붙여 본다
      const abs = path.resolve(t.file);
      if (!abs.startsWith(stage + path.sep)) continue;
      const rel = path.relative(stage, abs);
      if (turn.filed.has(rel)) continue;
      turn.filed.add(rel);
      emit({ event: "file", path: rel });
    }
  } else if (j.type === "result") {
    if (!turn || turn.done) return;  // 주입 없는 result — 이 봉투의 관할이 아니다
    // 죽은 resume 포인터의 실패 결과가 실어 오는 session_id 는 대화 없이 지어낸 즉석 값이다
    // (실측: num_turns 0). 이것을 종결로 받아 저장하면 다음 턴이 또 그 즉석 값을 resume 해
    // 같은 실패를 반복한다 — 종결로 받지 않고, 프로세스를 내린 뒤 새 세션으로 다시 시도한다
    if (j.is_error && resumedBoot && !restarted
      && (Array.isArray(j.errors) ? j.errors : []).some((e) => String(e).includes(RESUME_GONE))) {
      restarting = true;
      child.kill("SIGTERM");
      return;
    }
    // 빈 껍데기 result — 본문도 장부도 없는 것은 종결이 아니다. 이것을 종결로 받으면
    // 화면에 "(빈 응답)" 이 찍히고, 그 뒤에 오는 진짜 답은 종결에 막혀 통째로 버려진다
    if (!j.is_error && !String(j.result ?? "").trim() && !turn.said.trim() && !j.usage) return;
    turn.done = true;
    if (j.session_id) fs.writeFileSync(B + "/claude-session", j.session_id);
    // 본문이 비면 흘려보낸 중간 텍스트로 대신한다 — 도구만 돌고 끝난 턴도 말은 남는다
    const text = String(j.result ?? "").trim() || turn.said.trim();
    if (j.is_error) {
      emit({ event: "error", message: text.trim() || ("claude 실패 (" + (j.subtype ?? "사유 없음") + ")") });
      // 상주는 실패 종결 뒤에도 산다 — 대화는 디스크에 있고 다음 턴이 재시도 기회다
      if (MODE === "session") { process.exitCode = 1; retire(); }
      else { turn = null; if (closing) retire(); }
      return;
    }
    // 장부는 도구가 준 것만 옮긴다. 모델 이름은 본류 assistant 가 말한 값이 정본이고,
    // 없을 때만 modelUsage 에서 출력 토큰이 가장 많은 항목으로 대신한다
    const mu = j.modelUsage && typeof j.modelUsage === "object" ? j.modelUsage : {};
    const name = model
      ?? Object.entries(mu).sort((a, b) => (b[1]?.outputTokens ?? 0) - (a[1]?.outputTokens ?? 0))[0]?.[0]
      ?? null;
    const u = j.usage ?? {};
    emit({
      event: "reply",
      // 재시작 턴은 이전 문맥 없이 답한 것이다 — 그 사실을 본문 머리에 남긴다
      text: turn.restarted ? "(이전 대화가 하네스에서 만료되어 새 대화로 시작했습니다.)\n\n" + text : text,
      session: j.session_id ?? null,
      model: name,
      usage: {
        input: (u.input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0),
        output: u.output_tokens ?? 0,
        context_window: (name && mu[name]?.contextWindow) ?? null,
      },
    });
    if (MODE === "session") retire();
    else { turn = null; if (closing) retire(); }
  }
};

// 제어 채널. 기판이 취소를 stdin 으로 먼저 보내고 신호는 그물로 쓴다.
// serve 모드는 같은 채널로 턴을 받는다 — 한 번에 한 턴(동시 주입은 기판 live 가드가 막는다)
let ctl = null;
try {
  ctl = readline.createInterface({ input: process.stdin });
  ctl.on("line", (line) => {
    let c;
    try { c = JSON.parse(line); } catch { return; }
    if (c?.type === "cancel") {
      if (cancelled) return;
      cancelled = true;
      if (!child) process.exit(130);
      child.kill("SIGTERM");
      // 도구가 정리에 실패해도 턴은 끝나야 한다
      killTimer = setTimeout(() => { try { child.kill("SIGKILL"); } catch { /* 이미 종료 */ } }, 3000);
      killTimer.unref?.();
      return;
    }
    if (c?.type === "turn" && MODE === "serve") {
      if (closing || cancelled) return;
      if (turn) { process.stderr.write("relay 봉투: 턴 진행 중 — 새 턴 무시\n"); return; }
      if (typeof c.prompt !== "string" || !c.prompt.trim()) return;
      inject(c.prompt);
    }
  });
  // 제어 채널 EOF = 기판의 은퇴 지시(유휴) 또는 기판 사망 — 진행 중 턴은 끝까지 배달하고 내린다
  ctl.on("close", () => {
    if (turn && !turn.done) { closing = true; return; }
    retire();
  });
  ctl.on("error", () => { /* 제어 채널 없음 — 신호로만 취소된다 */ });
} catch { /* stdin 이 없는 환경 */ }

function onClaudeClose(code) {
  if (killTimer) clearTimeout(killTimer);
  let tail = "";
  try { tail = fs.readFileSync(B + "/stderr.log", "utf8").trim().split("\n").slice(-3).join(" / "); } catch { /* 로그 없음 */ }
  // result 마커 없이 죽는 구현 대비 — stderr 꼬리에서도 죽은 포인터를 판정한다
  if (!restarting && !cancelled && !closing && turn && !turn.done
    && resumedBoot && !restarted && tail.includes(RESUME_GONE)) {
    restarting = true;
  }
  if (restarting && !cancelled) {
    restarting = false;
    restarted = true;
    fs.rmSync(B + "/claude-session", { force: true });
    child = null;
    inject(turn.prompt, { restarted: true });
    return;
  }
  if (closing) process.exit(process.exitCode ?? 0);
  if (cancelled) {
    if (turn && !turn.done) emit({ event: "error", message: "취소됨" });
    process.exit(130);
  }
  if (turn && !turn.done) {
    emit({ event: "error", message: "claude 응답 없음 (exit " + code + ")" + (tail ? " — " + tail : "") });
    process.exit(1);
  }
  // 유휴 중 사망 — 상주는 끝났다. 다음 턴은 새 상주가 디스크의 대화를 fresh resume 으로 잇는다
  process.exit(1);
}

if (MODE === "session") inject(process.argv[2] ?? "");
// serve 는 첫 턴 주입을 기다린다 — claude 부트도 그때다(resume 사다리를 첫 턴에 국한)
' "$VERB" "${2:-}" "${ARGS[@]}"
