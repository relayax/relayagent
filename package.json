{
  "name": "relayagent",
  "version": "0.3.3",
  "description": "A personal substrate for agent packages that ship their own screens.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/relayax/relayagent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relayax/relayagent.git"
  },
  "bugs": {
    "url": "https://github.com/relayax/relayagent/issues"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "agent-package",
    "claude-code",
    "codex",
    "harness",
    "manifest",
    "local-first"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "relay": "./runner/relay.ts"
  },
  "scripts": {
    "relay": "node --experimental-strip-types runner/relay.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test runner/*.test.ts",
    "validate": "node --experimental-strip-types runner/validate-all.ts",
    "build:widget": "npm --prefix lib/relayjs install --silent && npm --prefix lib/relayjs run build:chat",
    "typecheck:widget": "npm --prefix lib/relayjs install --silent && npm --prefix lib/relayjs run typecheck",
    "test:widget": "npm --prefix lib/relayjs install --silent && npm --prefix lib/relayjs run test",
    "pack:contract": "node tools/pack-contract.mjs"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
